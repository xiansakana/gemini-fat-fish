# 复制为 .env 后填入自己的密钥
GEMINI_API_KEY=你的密钥

# 默认用更聪明的 Flash；繁忙/限流时自动切到备用模型
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1beta

# 本地端口
PORT=8766

# 上下文与输出：尽量像真人，所以给足上下文和字数
RECENT_TURNS=24
HISTORY_KEEP=160
MAX_OUTPUT_TOKENS=512
MAX_FACTS=30

# 3.x 模型可填 minimal / low / medium / high；2.5 系列留空
THINKING_LEVEL=low

# 自我进化：auto=自动生效，confirm=每次要你说“采纳”
EVOLVE_EVERY=3
EVOLVE_MODE=auto
EVOLVE_OUTPUT_TOKENS=320

# 主动冒泡：多久没聊天后，让它自己发一句（分钟）
PROACTIVE_MINUTES=45

# ===== QQ 群 / 私聊（OneBot v11，可选）=====
# 不接 QQ 就整段留空，不影响网页端
# 机器人自己的 QQ 号（用来识别 @）
QQ_BOT_QQ=
# OneBot 实现的 HTTP API 地址；留空=干跑模式，只打印不真发
QQ_ONEBOT_API=http://127.0.0.1:3000
# 核心服务地址
QQ_CORE=http://127.0.0.1:8766
# 桥接服务端口（OneBot 的 HTTP 上报填 http://127.0.0.1:8767/onebot）
QQ_BRIDGE_PORT=8767
# 监听地址；NapCat 跑在 Docker 里时，容器访问宿主机是 docker 网关 IP，
# 需要填 0.0.0.0（务必配合防火墙只放行本机和 docker 网段）
QQ_BRIDGE_HOST=127.0.0.1
# 白名单：留空=不响应任何群/私聊；多个用逗号分隔
QQ_GROUP_WHITELIST=
QQ_PRIVATE_WHITELIST=
# 唤醒词：被 @、被回复、或文本里出现这些词时必回
QQ_WAKE_WORDS=小双,Gemini娘,双子
# 被叫必回；没被叫时走下面的“观察后决定”，QQ_INTERJECT 只作为兜底随机插话
QQ_INTERJECT=0.02
# 同一个群的回复冷却（秒）
QQ_COOLDOWN=25
# 群聊用的便宜模型与输出上限
QQ_GROUP_MODEL=gemini-3.5-flash-lite
QQ_GROUP_MAX_TOKENS=260
# 每天最多调用多少次模型（防刷）
QQ_DAILY_CALLS=300

# ===== 群聊观察：像真人一样听着，再决定要不要开口 =====
# 每条群消息都进缓冲区；攒够消息且过了间隔，才调一次 lite 模型评估激活度
QQ_OBSERVE_ENABLED=1
QQ_OBSERVE_MODEL=gemini-3.5-flash-lite
QQ_OBSERVE_MAX_TOKENS=240
QQ_OBSERVE_WINDOW=15
# 至少攒够几条新消息、距上次评估多少秒，才评估一次
QQ_OBSERVE_MIN_MESSAGES=3
QQ_OBSERVE_INTERVAL=45
# 激活度达到这个分数（0~10）才开口
QQ_OBSERVE_THRESHOLD=6
# 她开口之后多久不再主动说话（秒，默认 4 分钟）
QQ_OBSERVE_COOLDOWN=240
# 观察评估单独的每日额度
QQ_OBSERVE_DAILY_CALLS=200

