# 复制为 .env 后填入自己的密钥
GEMINI_API_KEY=你的密钥

# 默认用更聪明的 Flash；繁忙/限流时自动切到备用模型
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1beta

# 本地端口
PORT=8766

# 上下文与输出：尽量像真人，所以给足上下文和字数
RECENT_TURNS=24
HISTORY_KEEP=160
MAX_OUTPUT_TOKENS=512
MAX_FACTS=30

# 3.x 模型可填 minimal / low / medium / high；2.5 系列留空
THINKING_LEVEL=low

# 自我进化：auto=自动生效，confirm=每次要你说“采纳”
EVOLVE_EVERY=3
EVOLVE_MODE=auto
EVOLVE_OUTPUT_TOKENS=320

# 主动冒泡：多久没聊天后，让它自己发一句（分钟）
PROACTIVE_MINUTES=45

# ===== QQ 群 / 私聊（OneBot v11，可选）=====
# 不接 QQ 就整段留空，不影响网页端
# 机器人自己的 QQ 号（用来识别 @）
QQ_BOT_QQ=
# OneBot 实现的 HTTP API 地址；留空=干跑模式，只打印不真发
QQ_ONEBOT_API=http://127.0.0.1:3000
# 核心服务地址
QQ_CORE=http://127.0.0.1:8766
# 桥接服务端口（OneBot 的 HTTP 上报填 http://127.0.0.1:8767/onebot）
QQ_BRIDGE_PORT=8767
# 监听地址；NapCat 跑在 Docker 里时，容器访问宿主机是 docker 网关 IP，
# 需要填 0.0.0.0（务必配合防火墙只放行本机和 docker 网段）
QQ_BRIDGE_HOST=127.0.0.1
# 白名单：留空=不响应任何群/私聊；多个用逗号分隔；填 * 表示任何群都生效
QQ_GROUP_WHITELIST=
QQ_PRIVATE_WHITELIST=
# 唤醒词：被 @、被回复、或文本里出现这些词时必回
QQ_WAKE_WORDS=小双,Gemini娘,双子
# 被叫必回；没被叫时走下面的“观察后决定”，QQ_INTERJECT 只作为兜底随机插话
QQ_INTERJECT=0.02
# 没被叫时的回复冷却（秒）
QQ_COOLDOWN=25
# 被 @ / 叫名字 / 被回复时的最短间隔；冷却期内会稍等一下再回，不吞消息
QQ_DIRECT_COOLDOWN=5
# 管理员 QQ：只有他能用 /quiet /chatty /normal /人设（留空=没人能改）
QQ_ADMIN_QQ=
# 群聊用的便宜模型与输出上限
QQ_GROUP_MODEL=gemini-3.5-flash-lite
QQ_GROUP_MAX_TOKENS=260
# 明确查询任务（查行情/资料）时的输出上限，比闲聊高得多，给完整信息
QQ_QUERY_MAX_TOKENS=2048
# 每天最多调用多少次模型（防刷）
QQ_DAILY_CALLS=300

# ===== 历史回填：进新群时先看一遍聊天记录 =====
# 被拉进群或第一次见到某个群时，往回翻多少条历史（0=关闭）
QQ_BACKFILL_COUNT=200
# 每群在内存里保留多少条消息当上下文（回填要靠它留住）
QQ_BUFFER_MAX=240
# 刚进群这段时间只潜水不主动插话（秒）
QQ_GROUP_WARMUP=300
# 管理员邀请入群时自动同意（不然她进不去）
QQ_AUTO_ACCEPT_INVITE=1
# 被拉进一个还没人说话的新群时，打个招呼
QQ_JOIN_GREET=1

# ===== 群聊观察：像真人一样听着，再决定要不要开口 =====
# 每条群消息都进缓冲区；攒够消息且过了间隔，才调一次 lite 模型评估激活度
QQ_OBSERVE_ENABLED=1
QQ_OBSERVE_MODEL=gemini-3.5-flash-lite
QQ_OBSERVE_MAX_TOKENS=240
QQ_OBSERVE_WINDOW=15
# 至少攒够几条新消息、距上次评估多少秒，才评估一次
QQ_OBSERVE_MIN_MESSAGES=3
QQ_OBSERVE_INTERVAL=45
# 激活度达到这个分数（0~10）才开口
QQ_OBSERVE_THRESHOLD=6
# 她开口之后多久不再主动说话（秒，默认 4 分钟）
QQ_OBSERVE_COOLDOWN=240
# 上下文追问：没 @ 但明显接着她的话问（如“所以你在哪”），也算叫她
QQ_CONTEXT_PROBE=1
# 只在她刚说完这段话的这段时间内做判定（秒）
QQ_CONTEXT_PROBE_WINDOW=180
# 同一群两次上下文判定的最短间隔（秒，防刷 token）
QQ_CONTEXT_PROBE_GAP=12
# 群聊回复时随机附一张表情差分的概率（0=关闭）
QQ_STICKER_RATE=0.08
# 撤回 / 入群 / 退群时回应概率与最短间隔
QQ_NOTICE_RATE=0.5
QQ_NOTICE_GAP=60
# 观察评估单独的每日额度
QQ_OBSERVE_DAILY_CALLS=200


# ===== 后台日志页（deploy/logview.py）=====
LOGVIEW_PORT=8770
LOGVIEW_HOST=0.0.0.0
# 访问令牌：留空则日志页拒绝启动；用 openssl rand -hex 12 生成
LOGVIEW_TOKEN=

# ===== 图片 / 视频理解 =====
# 被 @ / 叫名字 / 被回复时，把图里的内容也送进模型（1=开，0=只看占位符）
QQ_VISION=1
# 单条消息最多带几张图
QQ_VISION_MAX_IMAGES=3
# 视频原文件上限（MB），超过直接放弃
QQ_VISION_VIDEO_MB=20
# 视频最长截取多少秒，超长会先压缩/截断
QQ_VISION_VIDEO_SECONDS=45

# 她眼里的时区：留空跟随系统，填 8 表示 UTC+8（换服务器也不会答错时间）
TZ_OFFSET=8

# ===== 联网与刷 B 站 =====
# 群聊里允许只读联网工具（搜索 / 网页 / B站），文件与终端工具仍然只在网页端
QQ_GROUP_WEB=1
# 自己刷 B 站：定时挑一条热门写进记忆，聊天时可能自然提起
SURF_ENABLED=1
SURF_INTERVAL_MINUTES=180
SURF_DAILY_CALLS=8
SURF_MODEL=gemini-3.5-flash-lite
# 顺着群聊话题搜视频（1=开，搜不到回退热门榜）
SURF_FOLLOW_GROUP_TOPICS=1
# 刷到本群话题相关的视频后，主动分享到群里的概率与时段
QQ_SURF_SHARE_RATE=0.4
QQ_SURF_SHARE_START=9
QQ_SURF_SHARE_END=23
# 自己刷知乎热榜：定时挑一条写进记忆
ZHIHU_ENABLED=1
ZHIHU_INTERVAL_MINUTES=240
ZHIHU_DAILY_CALLS=4
ZHIHU_MODEL=gemini-3.5-flash-lite
# 知乎热度达到多少「万」才主动分享（默认 1000 万）
ZHIHU_SHARE_MIN_HEAT=1000
# 自己刷微博热搜（靠访客 cookie 拿榜）
WEIBO_ENABLED=1
WEIBO_INTERVAL_MINUTES=240
WEIBO_DAILY_CALLS=4
WEIBO_MODEL=gemini-3.5-flash-lite
# 微博热度（绝对值）达到多少才主动分享，默认 100 万
WEIBO_SHARE_MIN_HEAT=1000000
# 两次主动分享的最短间隔（分钟），B 站与知乎共用，保证轮流
QQ_SURF_SHARE_GAP=90

# 阈值是否随群活跃度浮动（1=浮动，0=固定为 QQ_OBSERVE_THRESHOLD / talk_value）
QQ_THRESHOLD_DYNAMIC=1

# 话痨模式：追加一句风格提示，留空则恢复原人设
QQ_CHATTY_HINT=
# 低于这个值不再降（默认 3）
QQ_THRESHOLD_MIN=3
# 最少几个人说话才评估（默认 2）
QQ_OBSERVE_MIN_SPEAKERS=2
# 一次回复最多拆成几条消息（默认 2）
QQ_SPLIT_PARTS=2

# 拟人打字节奏：每字毫秒数、多条之间最长停顿（秒）
QQ_TYPING_MS=90
QQ_TYPING_MAX=6

# 被拉进新群时自动把群号写进白名单（1=开，0=关），省得每次手改
QQ_AUTO_WHITELIST=1
